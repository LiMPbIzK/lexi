---
import ThemeSelector from '../components/ThemeSelector.svelte';
import VoiceSelector from '../components/VoiceSelector.svelte';
import ConnectionStatus from '../components/ConnectionStatus.svelte';
import FeedbackButton from '../components/FeedbackButton.svelte';
import UserGreeting from '../components/UserGreeting.svelte';
import UsageStats from '../components/UsageStats.svelte';
import '../styles/global.css';
import '../styles/themes.css';

interface Props {
  title?: string;
}

const { title = 'LeXi' } = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es" data-theme="neutral">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="LeXi — Comunicador AAC con tarjetas, sonido y teclado virtual." />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} — LeXi</title>
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <span class="logo">LeXi</span>
        <span class="tagline">Comunicador AAC</span>
      </div>

      <div class="topbar-controls">
        <UserGreeting client:load />
        <VoiceSelector client:load />
        <ConnectionStatus client:load />
        <UsageStats client:load />
        <ThemeSelector client:load />
      </div>
    </header>

    <slot />

    <FeedbackButton />

    <footer class="footer">
      <p>LeXi — Comunicador AAC · © {currentYear}</p>
      <p class="footer-attribution">
        Símbolos pictográficos propiedad del Gobierno de Aragón, creados por
        Sergio Palao para{' '}
        <a href="https://arasaac.org" rel="noopener noreferrer" target="_blank">ARASAAC</a>{' '}
        (licencia{' '}
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          rel="noopener noreferrer"
          target="_blank"
        >
          CC BY-NC-SA 4.0
        </a>
        ).
      </p>
    </footer>

    <script>
      const saved = localStorage.getItem('lexi:theme');
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </body>
</html>
