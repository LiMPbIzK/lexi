{
  "name": "lexi",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "LeXi — AAC Communicator (PWA offline-first)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:functions": "tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --strict functions/api/upload.ts \"functions/api/audio/[[key]].ts\" functions/api/claim.ts functions/telegram/webhook.ts functions/env.d.ts",
    "icons": "node scripts/generate-icons.mjs",
    "db:local": "wrangler d1 migrations apply lexidb --local",
    "db:remote": "wrangler d1 migrations apply lexidb --remote",
    "pages:dev": "astro build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.0.5",
    "@nanostores/svelte-runes": "^1.0.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.0.0",
    "nanostores": "^1.4.2",
    "svelte": "^5.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260812.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
