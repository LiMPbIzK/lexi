{
	"name": "lexi",
	"pages_build_output_dir": "dist",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"MAX_AUDIO_PER_DEVICE": 100,
		"MAX_BYTES_PER_DEVICE": 104857600,
		"MAX_UPLOADS_PER_HOUR": 20,
		"MAX_RECORDING_MS": 30000
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lexidb",
			"database_id": "286181dd-d951-4a71-84ea-99a96bfd1021",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "lexi-audio"
		}
	]
}
