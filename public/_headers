/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://static.arasaac.org https:; media-src 'self' blob: data:; connect-src 'self' https://lexi.fmartinezgarcia.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'
  Permissions-Policy: microphone=(self), camera=(self)
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cache-Control: public, max-age=0, must-revalidate

# El Service Worker NUNCA debe cachearse o las actualizaciones no llegan.
# CDN-Cache-Control controla la caché de borde del CDN en dominios personalizados.
/sw.js
  Cache-Control: no-cache
  CDN-Cache-Control: no-cache

# El manifest no debe cachearse para reflejar cambios de iconos/screenshots.
/manifest.webmanifest
  Cache-Control: no-cache
  CDN-Cache-Control: no-cache

# HTML sin caché (siempre sirve la última versión).
/index.html
  Cache-Control: no-cache

# Assets hasheados (cambian de nombre con cada build): caché larga + immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
